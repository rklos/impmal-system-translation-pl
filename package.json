{
  "name": "impmal-system-translation-pl",
  "version": "3.0.0-alpha",
  "type": "module",
  "scripts": {
    "prebuild": "npm run auto-import-styles && tsc --noEmit",
    "build": "vite build",
    "postbuild": "tsx tools/bundle-jsons.ts",
    "report": "tsx tools/commands/report/command.ts",
    "sync": "tsx tools/commands/sync/command.ts",
    "patch": "tsx tools/commands/patch/command.ts",
    "bump-version": "tsx tools/bump-version.ts",
    "auto-import-styles": "tsx tools/auto-import-styles.ts",
    "scaffold": "npx yo fvtt:warhammer-translation",
    "foundry:start": "tsx tests/foundry/bootstrap/start-compose.ts",
    "typecheck:foundry": "tsc --noEmit -p tests/foundry/tsconfig.json",
    "test": "vitest run",
    "test:foundry": "playwright test -c tests/foundry/playwright.config.ts",
    "test:foundry:compose": "FOUNDRY_TEST_RUNTIME=compose playwright test -c tests/foundry/playwright.config.ts",
    "test:foundry:ui": "playwright test -c tests/foundry/playwright.config.ts --ui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rklos/impmal-system-translation-pl.git"
  },
  "author": "Radosław Kłos <radoslaw@klos.dev>",
  "bugs": {
    "url": "https://github.com/rklos/impmal-system-translation-pl/issues"
  },
  "homepage": "https://github.com/rklos/impmal-system-translation-pl#readme",
  "dependencies": {
    "diff": "8.0.2"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "1.1.0",
    "@octokit/core": "7.0.3",
    "@playwright/test": "1.62.0",
    "@rklos/eslint-configs": "github:rklos/eslint-configs#23d629e6213ced8d9df0638fa4da193148b43ae4",
    "@types/node": "24.13.3",
    "chalk": "5.4.1",
    "discord.js": "14.21.0",
    "eslint": "10.0.3",
    "eslint-import-resolver-typescript": "4.4.4",
    "fs-extra": "11.3.4",
    "fvtt-types": "github:League-of-Foundry-Developers/foundry-vtt-types#main",
    "generator-fvtt": "github:rklos/fvtt-generator",
    "sass": "1.98.0",
    "simple-git": "3.28.0",
    "testcontainers": "12.0.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "8.0.0",
    "vitest": "4.1.10",
    "yo": "7.0.0"
  },
  "license": "GPL-3.0"
}
